# ---------------------------------------------------------------------------
# Example variable values for a portfolio-style deployment.
#
# Copy to terraform.tfvars and fill in the four credential values near the
# bottom. terraform.tfvars is gitignored - see ../../../.gitignore - so those
# real values never get committed by accident.
#
# Everything except the credential section is safe to commit as-is: no real
# secrets, only sizing, naming and cost choices. Nothing in this repository
# runs `terraform apply` on your behalf - see docs/aws-deployment.md.
# ---------------------------------------------------------------------------

aws_region   = "us-east-1"
environment  = "production"
project_name = "devpulse"

# --- Cost-conscious defaults for a short-lived demo deployment -------------
# false skips the NAT Gateway (~$32/month + data processing, the single
# largest fixed cost in this architecture) and runs ECS tasks in the public
# subnets instead, still reachable only from the ALB via security groups.
# Set to true for a deployment meant to stay up long-term. See the
# enable_nat_gateway variable description in variables.tf for the full
# tradeoff.
enable_nat_gateway = false

az_count = 2

# --- Load balancer / domain --------------------------------------------------
# Leave both empty to serve over plain HTTP at the ALB's own DNS name.
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"
# app_domain      = "devpulse.example.com"

# --- Container images --------------------------------------------------------
# Leave both empty. The ECS task definitions then name
# "<repository_url>:bootstrap" - the one image pushed by hand before the first
# apply (see docs/aws-deployment.md). Every deploy after that renders an
# immutable "sha-<commit>" tag into the task definition itself, so these two
# variables stay empty in normal operation and exist only for pinning a
# specific image outside the pipeline.
# bootstrap_image_tag = "bootstrap"
# backend_image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/devpulse-production-backend:sha-abc1234"
# frontend_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/devpulse-production-frontend:sha-abc1234"

# --- Sizing (defaults below are already the smallest practical Fargate task) -
# backend_cpu             = 256
# backend_memory          = 512
# backend_desired_count   = 1
# frontend_cpu            = 256
# frontend_memory         = 512
# frontend_desired_count  = 1
# worker_cpu              = 256
# worker_memory           = 512
# worker_desired_count    = 1

# --- RDS PostgreSQL --------------------------------------------------------------
# Defaults are already the cheapest practical setup for a demo: smallest
# Graviton instance class, no Multi-AZ, no automated backups, deletion
# protection off, final snapshot skipped - so `terraform destroy` leaves
# nothing behind. Raise these for anything meant to hold real data.
# db_instance_class        = "db.t4g.micro"
# db_multi_az              = false
# db_backup_retention_days = 0
# db_deletion_protection   = false
# db_skip_final_snapshot   = true

# --- ElastiCache Redis -----------------------------------------------------------
# redis_node_type       = "cache.t4g.micro"
# redis_num_cache_nodes = 1

# --- S3 --------------------------------------------------------------------------
# s3_force_destroy             = true
# s3_lifecycle_expiration_days = 90

# --- Logging and alarms -----------------------------------------------------------
# log_retention_days         = 14
# container_insights_enabled = false
#
# Alarms are off by default - an alarm with nowhere to notify still bills
# per alarm-month for no benefit. Create an SNS topic and subscribe your own
# email/Slack to it first, then point alarm_actions at it:
# enable_alarms = true
# alarm_actions = ["arn:aws:sns:us-east-1:123456789012:devpulse-alerts"]

# --- Application secrets (REQUIRED - real credentials, not example values) ----
# These four are not generated by Terraform - they come from real external
# accounts (an OpenAI account, a GitHub OAuth App) and must be supplied here.
# DATABASE_URL, REDIS_URL and JWT_SECRET need no entry - Terraform generates
# and stores those itself. See secrets.tf.
#
# openai_api_key         = "sk-..."
# github_client_id       = "Iv1...."
# github_client_secret   = "..."
# github_webhook_secret  = "..."
