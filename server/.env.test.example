# Environment for `npm test`. Copy to `.env.test` before running the suite.
#
# The database here is TRUNCATED between every test, so it must never point at a
# database you care about — src/test/setup.js refuses to run unless the name ends
# in `_test`. Create it once with:
#   docker compose exec db psql -U postgres -c "CREATE DATABASE devpulse_test;"
#   npm run test:db:migrate

NODE_ENV=test

DATABASE_URL=postgresql://postgres:password@localhost:5432/devpulse_test

# Trailing /1 selects Redis logical database 1, keeping test cache keys off the
# dev keyspace (db 0). setup.js flushes this database between tests.
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-secret-not-used-outside-tests

# Pinned so webhook-registration branches behave the same whether or not the
# developer's dev .env happens to define one. Outbound GitHub calls are mocked.
GITHUB_WEBHOOK_SECRET=test-webhook-secret
WEBHOOK_BASE_URL=http://localhost:3001
