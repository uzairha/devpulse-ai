# ---------------------------------------------------------------------------
# Local development configuration. Copy to .env and fill in the blanks.
#
# In AWS these same values are supplied to the ECS task from Secrets Manager
# and the task definition - nothing here is read from a file in production.
# See docs/aws-deployment.md.
# ---------------------------------------------------------------------------

# Server
PORT=3001
NODE_ENV=development

# Reverse proxies in front of the app. Behind the ALB this is 1; locally 0.
TRUST_PROXY_HOPS=0

# Run the BullMQ workers inside the API process. Defaults to true outside
# production, where the worker runs as its own service instead.
# RUN_WORKERS_IN_API=true

# Client origin, used for CORS. In AWS the ALB serves the app and the API from
# a single origin, so cross-origin requests do not arise.
CLIENT_URL=http://localhost:5173

# Auth - REQUIRED in production. Boot fails if this is unset or left at the
# development default below.
JWT_SECRET=dev-secret-change-in-production

# Database - REQUIRED in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/devpulse

# Redis
REDIS_URL=redis://localhost:6379

# GitHub OAuth (created at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
# Public URL GitHub can reach to deliver webhooks (ngrok or similar in dev)
WEBHOOK_BASE_URL=http://localhost:3001

# OpenAI
OPENAI_API_KEY=
