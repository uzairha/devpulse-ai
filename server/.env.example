# Server
PORT=3001
NODE_ENV=development

# Client (for CORS)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/devpulse

# Redis
REDIS_URL=redis://localhost:6379

# GitHub OAuth (created at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@devpulse.ai

# Sentry (optional)
SENTRY_DSN=
